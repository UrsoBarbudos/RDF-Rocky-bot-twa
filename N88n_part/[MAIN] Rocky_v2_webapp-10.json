    {
      "parameters": {
        "jsCode": "// --- 1. Получаем все данные от Telegram ---\nconst update = $input.all()[0].json;\n\n// --- 2. Проверяем, что это вообще нажатие на кнопку ---\nif (!update.callback_query) {\n  return [{ json: { error: 'No callback query' } }];\n}\n\n// --- 3. Достаем строку из кнопки, например \"approve_12345_recABCDE\" ---\nconst callbackData = update.callback_query.data;\n\n// --- 4. ВОТ ЭТА СТРОКА ПРОПАЛА: Разделяем строку на части по символу \"_\" ---\nconst parts = callbackData.split('_'); \n\n// --- 5. Проверяем, что частей ровно 3 (действие, id_пользователя, id_записи) ---\nif (parts.length !== 3) {\n  console.error('Invalid callback_data format:', callbackData);\n  return [{ json: { error: 'Invalid callback data format' } }];\n}\n\n// --- 6. Берем первое слово (approve, reject или block) ---\nconst action = parts[0];\n\n// --- 7. Превращаем его в статус, который поймет Airtable ---\nlet statusForAirtable = '';\nif (action === 'approve') {\n  statusForAirtable = 'Approved';\n} else if (action === 'reject' || action === 'block') { // Ловим оба возможных варианта для отклонения\n  statusForAirtable = 'Blocked';\n}\n\n// --- 8. Если пришло что-то непонятное, лучше вернуть ошибку ---\nif (statusForAirtable === '') {\n  console.error('Invalid action:', action);\n  return [{ json: { error: 'Invalid action from callback' } }];\n}\n\n// --- 9. Возвращаем все данные в удобном виде для следующих узлов ---\nreturn [{\n  json: {\n    status: statusForAirtable, // <-- Правильный статус для Airtable\n    action: action,            // <-- Исходное действие\n    target_chat_id: parts[1],\n    record_id: parts[2],\n    admin_id: update.callback_query.from.id,\n    admin_username: update.callback_query.from.username || 'unknown',\n    message_id: update.callback_query.message.message_id,\n    chat_id: update.callback_query.message.chat.id,\n    callback_query_id: update.callback_query.id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
